
<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1"
    xmlns:views="clr-namespace:MauiAppHotel.Views"
    FlyoutBehavior="Flyout"
    Title="Hotel MAUI">

    <FlyoutItem Title="Início" FlyoutDisplayOptions="AsSingleItem">
        <ShellContent
            Title="Início"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Sobre" FlyoutDisplayOptions="AsSingleItem">
        <ShellContent
            Title="Sobre"
            ContentTemplate="{DataTemplate views:Sobre}"
            Route="Sobre" />
    </FlyoutItem>

</Shell>
